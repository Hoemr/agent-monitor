<?xml version="1.0" encoding="UTF-8"?>
<Mascot xmlns="http://www.group-finity.com/Mascot">
  <ActionList>
    <Action Name="Stand" Type="Stay" BorderType="Floor">
      <Animation>
        <Pose Image="/shime2.png" ImageAnchor="36,72" Velocity="0,0" Duration="60" />
        <Pose Image="/shime3.png" ImageAnchor="36,72" Velocity="0,0" Duration="60" />
        <Pose Image="/shime4.png" ImageAnchor="36,72" Velocity="0,0" Duration="60" />
      </Animation>
    </Action>
    <Action Name="Walk" Type="Move" BorderType="Floor">
      <Animation>
        <Pose Image="/shime5.png" ImageAnchor="36,72" Velocity="-1,0" Duration="8" />
        <Pose Image="/shime6.png" ImageAnchor="36,72" Velocity="-1,0" Duration="8" />
      </Animation>
    </Action>
    <Action Name="Run" Type="Move" BorderType="Floor">
      <Animation>
        <Pose Image="/shime5.png" ImageAnchor="36,72" Velocity="-3,0" Duration="2" />
        <Pose Image="/shime6.png" ImageAnchor="36,72" Velocity="-3,0" Duration="2" />
      </Animation>
    </Action>
    <Action Name="Falling" Type="Embedded" Class="com.group_finity.mascot.action.Fall" Gravity="2" RegistanceX="0.05" RegistanceY="0.1">
      <Animation><Pose Image="/shime6.png" ImageAnchor="36,72" Velocity="0,0" Duration="250" /></Animation>
    </Action>
    <Action Name="Jumping" Type="Embedded" Class="com.group_finity.mascot.action.Jump" VelocityParam="16">
      <Animation><Pose Image="/shime7.png" ImageAnchor="36,72" Velocity="0,0" Duration="250" /></Animation>
    </Action>
    <Action Name="Bouncing" Type="Animate" BorderType="Floor">
      <Animation>
        <Pose Image="/shime7.png" ImageAnchor="36,72" Velocity="0,0" Duration="8" />
        <Pose Image="/shime1.png" ImageAnchor="36,72" Velocity="0,0" Duration="8" />
      </Animation>
    </Action>
    <Action Name="Tripping" Type="Animate" BorderType="Floor">
      <Animation>
        <Pose Image="/shime8.png" ImageAnchor="36,72" Velocity="-1,0" Duration="10" />
        <Pose Image="/shime1.png" ImageAnchor="36,72" Velocity="0,0" Duration="6" />
      </Animation>
    </Action>
    <Action Name="SitDown" Type="Stay" BorderType="Floor">
      <Animation><Pose Image="/shime9.png" ImageAnchor="36,72" Velocity="0,0" Duration="120" /></Animation>
    </Action>
    <Action Name="Dragged" Type="Embedded" Class="com.group_finity.mascot.action.Dragged">
      <Animation><Pose Image="/shime10.png" ImageAnchor="36,72" Velocity="0,0" Duration="250" /></Animation>
    </Action>
  </ActionList>
</Mascot>
