{
  "$schema": "https://raw.githubusercontent.com/nicegui/tauri-schema/refs/heads/main/tauri.conf.v2.0.json",
  "productName": "Agent Monitor",
  "version": "0.3.1",
  "identifier": "com.agent.monitor",
  "build": {
    "beforeDevCommand": "npx -y serve src -l 1420 --no-clipboard",
    "frontendDist": "../src",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Agent Monitor",
        "width": 360,
        "height": 520,
        "resizable": true,
        "minWidth": 280,
        "minHeight": 200,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "center": true
      }
    ],
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    },
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.ico"],
    "targets": ["nsis"]
  }
}
