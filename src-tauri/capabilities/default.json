{
  "$schema": "https://raw.githubusercontent.com/nicegui/tauri-schema/refs/heads/main/capabilities/v2/default.json",
  "identifier": "default",
  "description": "Desktop pet + settings + island window capabilities: render events, drag the pet, read/write settings through app commands.",
  "windows": ["main", "settings", "island"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "opener:default"
  ]
}
